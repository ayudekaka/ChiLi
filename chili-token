<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHILI Token | 小辣椒</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #333;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
            padding: 20px;
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* 导航栏 */
        .navbar {
            background: white;
            padding: 15px 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            position: sticky;
            top: 20px;
            z-index: 100;
            flex-wrap: wrap;
            gap: 10px;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 20px;
            font-weight: bold;
        }

        .navbar-brand .emoji {
            font-size: 24px;
        }

        .navbar-brand .text {
            color: #667eea;
        }

        /* 主内容区域 */
        .main-section {
            background: white;
            border-radius: 16px;
            padding: 30px 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }

        .main-section h1 {
            font-size: 36px;
            color: #667eea;
            margin-bottom: 10px;
        }

        .main-section .subtitle {
            font-size: 16px;
            color: #999;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .main-section .description {
            color: #666;
            line-height: 1.8;
            margin-bottom: 20px;
            font-size: 14px;
        }

        /* 分隔线 */
        .divider {
            height: 2px;
            background: linear-gradient(to right, transparent, #e0e0e0, transparent);
            margin: 25px 0;
        }

        /* 卡片样式 */
        .card {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }

        .card h2 {
            font-size: 22px;
            color: #667eea;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f0f0f0;
        }

        .card h3 {
            font-size: 16px;
            color: #333;
            margin-bottom: 12px;
            margin-top: 0;
        }

        /* 信息卡片组 */
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .info-card {
            background: linear-gradient(135deg, #f5f7ff 0%, #f9f9ff 100%);
            padding: 18px;
            border-radius: 12px;
            border-left: 4px solid #ff6b6b;
        }

        .info-card .label {
            font-size: 11px;
            color: #999;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .info-card .value {
            font-size: 16px;
            font-weight: bold;
            color: #333;
            word-break: break-word;
        }

        /* 地址框 */
        .address-section {
            background: linear-gradient(135deg, #f5f7ff 0%, #f9f9ff 100%);
            padding: 20px;
            border-radius: 12px;
            border-left: 4px solid #ff6b6b;
            margin-bottom: 15px;
        }

        .address-box {
            background: white;
            padding: 15px;
            border-radius: 8px;
            border: 2px solid #e0e0e0;
            font-family: 'Courier New', monospace;
            font-size: 12px;
            font-weight: bold;
            color: #333;
            word-break: break-all;
            margin-bottom: 12px;
            line-height: 1.6;
        }

        .btn-small {
            width: 100%;
            padding: 11px 15px;
            background: #ff6b6b;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
            font-size: 13px;
        }

        .btn-small:active {
            background: #ff5252;
            transform: scale(0.98);
        }

        .btn-small:hover {
            background: #ff5252;
        }

        /* 链接列表 */
        .links-list {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .link-item {
            padding: 15px;
            background: #f9f9f9;
            border-radius: 8px;
            border-left: 4px solid #667eea;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
        }

        .link-item:active {
            background: #f0f0f0;
            transform: translateX(3px);
        }

        .link-item .label {
            font-size: 13px;
            color: #666;
            font-weight: 500;
        }

        .link-item a {
            color: #667eea;
            text-decoration: none;
            font-weight: bold;
            transition: color 0.3s;
            font-size: 13px;
        }

        .link-item a:active {
            color: #ff6b6b;
        }

        .coming-soon {
            color: #999;
            font-size: 12px;
        }

        /* 步骤列表 */
        .steps {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .step {
            padding: 15px;
            background: #f9f9f9;
            border-radius: 8px;
            border-left: 4px solid #ff6b6b;
        }

        .step-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 8px;
        }

        .step-num {
            display: inline-flex;
            width: 32px;
            height: 32px;
            background: #ff6b6b;
            color: white;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
            flex-shrink: 0;
        }

        .step-title {
            font-weight: bold;
            color: #333;
            font-size: 14px;
        }

        .step-desc {
            color: #666;
            font-size: 13px;
            line-height: 1.6;
            margin-left: 44px;
        }

        /* 警告框 */
        .warning-box {
            background: #fff9e6;
            border-left: 4px solid #ff9800;
            padding: 15px;
            border-radius: 8px;
            font-size: 12px;
            color: #666;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .warning-box strong {
            color: #ff9800;
        }

        /* 页脚 */
        .footer {
            background: white;
            padding: 20px 25px;
            border-radius: 12px;
            text-align: center;
            color: #999;
            font-size: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
        }

        /* 动画 */
        @keyframes slideInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card, .main-section {
            animation: slideInUp 0.5s ease-out;
        }

        /* 响应式设计 */
        @media (max-width: 768px) {
            .navbar {
                top: 10px;
                padding: 12px 15px;
            }

            .main-section, .card {
                padding: 20px 15px;
            }

            .main-section h1 {
                font-size: 28px;
            }

            .card h2 {
                font-size: 18px;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .container {
                padding: 10px;
            }
        }

        @media (max-width: 480px) {
            .navbar-brand {
                font-size: 16px;
            }

            .navbar-brand .emoji {
                font-size: 20px;
            }

            .main-section h1 {
                font-size: 24px;
            }

            .card h2 {
                font-size: 16px;
            }

            .info-card .value {
                font-size: 14px;
            }

            .address-box {
                font-size: 11px;
            }

            .container {
                padding: 8px;
            }
        }

        /* 滚动条美化 */
        .container::-webkit-scrollbar {
            width: 8px;
        }

        .container::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
        }

        .container::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.3);
            border-radius: 10px;
        }

        .container::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.5);
        }
    </style>
</head>

<body>
