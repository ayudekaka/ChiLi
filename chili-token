                    <div class="info-card">
                        <div class="label">总供应量</div>
                        <div class="value">20,150,822</div>
                    </div>
                </div>
            </div>

            <!-- 合约地址卡片 -->
            <div class="card">
                <h2>🔐 合约地址</h2>
                <div class="address-section">
                    <div style="font-size: 12px; color: #999; margin-bottom: 8px; font-weight: bold; text-transform: uppercase;">
                        智能合约地址
                    </div>
                    <div class="address-box">0xed3caca4903256fb3e4997bc0c7830d19fb35f7c</div>
                    <button class="btn-small" onclick="copyAddress()">📋 复制合约地址</button>
                </div>
                <p style="color: #666; font-size: 12px; line-height: 1.6; margin-top: 15px; word-break: break-word;">
                    请在去中心化交易所（如 PancakeSwap）中使用该地址进行交换或添加流动性。请务必核对合约地址，防止诈骗。
                </p>
            </div>

            <!-- 官方链接 -->
            <div class="card">
                <h2>🔗 官方链接</h2>
                <div class="links-list">
                    <div class="link-item">
                        <div class="label">📊 BscScan</div>
                        <a href="https://bscscan.com/token/0xed3caca4903256fb3e4997bc0c7830d19fb35f7c" target="_blank">
                            查看 →
                        </a>
                    </div>
                    <div class="link-item">
                        <div class="label">🌐 官方网站</div>
                        <span class="coming-soon">Coming Soon</span>
                    </div>
                    <div class="link-item">
                        <div class="label">💬 Telegram</div>
                        <span class="coming-soon">Coming Soon</span>
                    </div>
                    <div class="link-item">
                        <div class="label">𝕏 Twitter</div>
                        <span class="coming-soon">Coming Soon</span>
                    </div>
                </div>
            </div>

            <!-- 如何获取指南 -->
            <div class="card">
                <h2>🎯 如何获取 CHILI</h2>
                <div class="steps">
                    <div class="step">
                        <div class="step-header">
                            <div class="step-num">1</div>
                            <div class="step-title">配置钱包</div>
                        </div>
                        <div class="step-desc">
                            在您的钱包（MetaMask、Trust Wallet 等）中添加 BNB Smart Chain 网络
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-header">
                            <div class="step-num">2</div>
                            <div class="step-title">前往交易所</div>
                        </div>
                        <div class="step-desc">
                            在 PancakeSwap 或其他去中心化交易所中搜索合约地址
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-header">
                            <div class="step-num">3</div>
                            <div class="step-title">交换代币</div>
                        </div>
                        <div class="step-desc">
                            使用 BNB 或其他代币交换 CHILI，或添加流动性
                        </div>
                    </div>
                </div>
            </div>

            <!-- 免责声明 -->
            <div class="card">
                <h2>⚠️ 免责声明</h2>
                <p style="color: #666; font-size: 13px; line-height: 1.8; margin-bottom: 12px; word-break: break-word;">
                    CHILI Token 是一个基于区块链技术的社区项目。参与前请进行充分的研究和了解，风险自担。我们不承诺任何投资回报，请仅将其作为社区参与的一部分。
                </p>
                <p style="font-size: 12px; color: #999; line-height: 1.6; word-break: break-word;">
                    CHILI Token is a community project based on blockchain technology. Users should conduct their own research before participating. We do not guarantee any investment returns.
                </p>
                <div class="warning-box">
                    💡 投资有风险，参与需谨慎。请确保您已完全了解代币机制和相关风险。
                </div>
            </div>

            <!-- 页脚 -->
            <div class="footer">
                © 2026 CHILI Token Community. All Rights Reserved.<br>社区驱动 · 去中心化发展
            </div>
        </div>
    </div>

    <script>
        function copyAddress() {
            const address = '0xed3caca4903256fb3e4997bc0c7830d19fb35f7c';
            navigator.clipboard.writeText(address).then(() => {
                const btn = event.target;
                const originalText = btn.innerText;
                btn.innerText = '✅ 已复制！';
                btn.style.background = '#4caf50';
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.style.background = '#ff6b6b';
                }, 2000);
            }).catch(() => {
                alert('复制失败，请手动复制：' + address);
            });
        }
    </script>
</body>

</html>