<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CHILI Token | 小辣椒</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #333;
            overflow-x: hidden;
        }

        body {
            display: flex;
            flex-direction: column;
            padding: 20px;
        }

        .wrapper {
            width: 100%;
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* 导航栏 */
        .navbar {
            background: white;
            padding: 15px 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 24px;
            font-weight: bold;
        }

        .navbar-brand .emoji {
            font-size: 28px;
        }

        .navbar-brand .text {
            color: #667eea;
        }

        .navbar-links {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }

        .navbar-links a {
            color: #667eea;
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s;
        }

        .navbar-links a:hover {
            color: #ff6b6b;
        }

        /* 主容器 */
        .content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            flex: 1;
        }

        /* 左半部分 */
        .section {
            background: white;
            border-radius: 16px;
            padding: 30px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        .section h1 {
            font-size: 32px;
            color: #667eea;
            margin-bottom: 10px;
        }

        .section h2 {
            font-size: 20px;
            color: #667eea;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f0f0f0;
        }

        .section h3 {
            font-size: 16px;
            color: #333;
            margin-bottom: 10px;
            margin-top: 15px;
        }

        .subtitle {
            font-size: 16px;
            color: #666;
            margin-bottom: 15px;
            line-height: 1.6;
        }

        .description {
            color: #888;
            line-height: 1.8;
            margin-bottom: 15px;
            font-size: 14px;
        }

        /* 信息卡片组 */
        .info-cards {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 20px;
        }

        .info-card {
            background: linear-gradient(135deg, #f5f7ff 0%, #f9f9ff 100%);
            padding: 20px;
            border-radius: 12px;
            border-left: 4px solid #ff6b6b;
        }

        .info-card .label {
            font-size: 12px;
            color: #999;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .info-card .value {
            font-size: 18px;
            font-weight: bold;
            color: #333;
            word-break: break-word;
        }

        /* 地址框 */
        .address-box {
            background: #f9f9f9;
            padding: 18px;
            border-radius: 10px;
            border: 2px solid #e0e0e0;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            font-weight: bold;
            color: #333;
            word-break: break-all;
            margin-bottom: 12px;
            overflow-x: auto;
        }

        .address-box::-webkit-scrollbar {
            height: 4px;
        }

        .address-box::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .address-box::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 10px;
        }

        /* 按钮 */
        .btn {
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .btn-primary {
            background: #ff6b6b;
            color: white;
            width: 100%;
        }

        .btn-primary:hover {
            background: #ff5252;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(255, 107, 107, 0.3);
        }

        .btn-secondary {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
            width: 100%;
            margin-top: 10px;
        }

        .btn-secondary:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
        }

        .btn-small {
            width: 100%;
            padding: 10px 15px;
            background: #ff6b6b;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            margin-top: 10px;
            transition: all 0.3s;
            font-size: 13px;
        }

        .btn-small:hover {
            background: #ff5252;
        }

        /* 链接列表 */
        .links-list {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .link-item {
            padding: 15px;
            background: #f9f9f9;
            border-radius: 8px;
            border-left: 4px solid #667eea;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s;
        }

        .link-item:hover {
            background: #f0f0f0;
            transform: translateX(5px);
        }

        .link-item .label {
            font-size: 13px;
            color: #666;
            font-weight: 500;
        }

        .link-item a {
            color: #667eea;
            text-decoration: none;
            font-weight: bold;
            transition: color 0.3s;
        }

        .link-item a:hover {
            color: #ff6b6b;
        }

        .coming-soon {
            color: #999;
            font-size: 13px;
        }

        /* 步骤列表 */
        .steps {
            display: grid;
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .step {
            padding: 15px;
            background: #f9f9f9;
            border-radius: 8px;
            border-left: 4px solid #ff6b6b;
        }

        .step .step-num {
            display: inline-block;
            width: 28px;
            height: 28px;
            background: #ff6b6b;
            color: white;
            border-radius: 50%;
            text-align: center;
            line-height: 28px;
            font-weight: bold;
            font-size: 14px;
            margin-bottom: 8px;
        }

        .step .step-title {
            font-weight: bold;
            color: #333;
            margin-bottom: 6px;
            font-size: 14px;
        }

        .step .step-desc {
            color: #666;
            font-size: 13px;
            line-height: 1.6;
        }

        /* 页脚 */
        .footer {
            background: white;
            padding: 20px 30px;
            border-radius: 12px;
            text-align: center;
            color: #999;
            font-size: 13px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            margin-top: auto;
        }

        /* 警告框 */
        .warning-box {
            background: #fff9e6;
            border-left: 4px solid #ff9800;
            padding: 15px;
            border-radius: 8px;
            font-size: 13px;
            color: #666;
            line-height: 1.6;
            margin-top: 15px;
        }

        /* 响应式设计 */
        @media (max-width: 768px) {
            .content {
                grid-template-columns: 1fr;
            }

            .navbar {
                flex-direction: column;
                align-items: flex-start;
            }

            .navbar-links {
                width: 100%;
                justify-content: flex-start;
            }

            .info-cards {
                grid-template-columns: 1fr;
            }

            .section {
                padding: 20px;
            }

            .section h1 {
                font-size: 24px;
            }

            .section h2 {
                font-size: 18px;
            }

            body {
                padding: 12px;
            }
        }

        @media (max-width: 480px) {
            .navbar-brand .text {
                font-size: 16px;
            }

            .section h1 {
                font-size: 20px;
            }

            .section h2 {
                font-size: 16px;
            }

            .info-card .value {
                font-size: 14px;
            }

            .address-box {
                font-size: 11px;
            }
        }

        /* 动画 */
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section {
            animation: fadeIn 0.5s ease-out;
        }

        .navbar {
            animation: fadeIn 0.5s ease-out 0.1s backwards;
        }

        .footer {
            animation: fadeIn 0.5s ease-out 0.2s backwards;
        }
    </style>
</head>

<body>
    <div class="wrapper">
        <!-- 导航栏 -->
        <div class="navbar">
            <div class="navbar-brand">
                <span class="emoji">🌶️</span>
                <span class="text">CHILI</span>
            </div>
            <div class="navbar-links">
                <a href="#about">关于</a>
                <a href="#info">代币信息</a>
                <a href="#contract">合约</a>
                <a href="#links">链接</a>
            </div>
        </div>

        <!-- 主内容 -->
        <div class="content">
            <!-- 左侧：项目介绍 + 代币信息 -->
            <div class="section">
                <h1 id="about">CHILI Token</h1>
                <p class="subtitle">小辣椒 | Community Driven Token</p>
                <p class="description">
                    CHILI（小辣椒）是一个部署在 BNB Smart Chain（币安智能链）上的社区驱动型代币，专注于社区参与和去中心化发展。
                </p>

                <h2 id="info">代币信息</h2>
                <div class="info-cards">
                    <div class="info-card">
                        <div class="label">代币名称</div>
                        <div class="value">CHILI</div>
                    </div>
                    <div class="info-card">
                        <div class="label">代币符号</div>
                        <div class="value">CHILI</div>
                    </div>
                    <div class="info-card">
                        <div class="label">网络</div>
                        <div class="value">BNB Smart Chain</div>
                    </div>
                    <div class="info-card">
                        <div class="label">总供应量</div>
                        <div class="value">20,150,822</div>
                    </div>
                </div>

                <h2 id="links">官方链接</h2>
                <div class="links-list">
                    <div class="link-item">
                        <div class="label">📊 BscScan</div>
                        <a href="https://bscscan.com/token/0xed3caca4903256fb3e4997bc0c7830d19fb35f7c" target="_blank">
                            查看 →
                        </a>
                    </div>
                    <div class="link-item">
                        <div class="label">🌐 官方网站</div>
                        <span class="coming-soon">Coming Soon</span>
                    </div>
                    <div class="link-item">
                        <div class="label">💬 Telegram</div>
                        <span class="coming-soon">Coming Soon</span>
                    </div>
                    <div class="link-item">
                        <div class="label">𝕏 Twitter</div>
                        <span class="coming-soon">Coming Soon</span>
                    </div>
                </div>

                <div class="warning-box">
                    ⚠️ <strong>免责声明：</strong> CHILI Token 是社区项目，参与前请充分了解风险，做好充分研究。
                </div>
            </div>

            <!-- 右侧：合约地址 + 获取指南 -->
            <div class="section">
                <h2 id="contract">🔐 合约地址</h2>
                <div class="address-box">0xed3caca4903256fb3e4997bc0c7830d19fb35f7c</div>
                <button class="btn-small" onclick="copyAddress()">📋 复制地址</button>
                <p class="description" style="margin-top: 15px; font-size: 12px;">
                    请在去中心化交易所（如 PancakeSwap）中使用该地址进行交换或添加流动性。
                </p>

                <h2 style="margin-top: 25px;">🎯 如何获取 CHILI</h2>
                <div class="steps">
                    <div class="step">
                        <div class="step-num">1</div>
                        <div class="step-title">配置钱包</div>
                        <div class="step-desc">
                            在钱包中添加 BNB Smart Chain 网络（MetaMask、Trust Wallet 等）
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-num">2</div>
                        <div class="step-title">前往交易所</div>
                        <div class="step-desc">
                            在 PancakeSwap 或其他 DEX 中搜索合约地址
                        </div>
                    </div>
                    <div class="step">
                        <div class="step-num">3</div>
                        <div class="step-title">交换代币</div>
                        <div class="step-desc">
                            使用 BNB 或其他代币交换 CHILI，或添加流动性
                        </div>
                    </div>
                </div>

                <div class="warning-box">
                    💡 <strong>温馨提示：</strong> 投资有风险，参与需谨慎。请确保核对合约地址，防止诈骗。
                </div>
            </div>
        </div>

        <!-- 页脚 -->
        <div class="footer">
            © 2026 CHILI Token Community. All Rights Reserved. | 社区驱动 · 去中心化发展
        </div>
    </div>

    <script>
        function copyAddress() {
            const address = '0xed3caca4903256fb3e4997bc0c7830d19fb35f7c';
            navigator.clipboard.writeText(address).then(() => {
                const btn = event.target;
                const originalText = btn.innerText;
                btn.innerText = '✅ 已复制！';
                btn.style.background = '#4caf50';
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.style.background = '#ff6b6b';
                }, 2000);
            }).catch(() => {
                alert('复制失败，请手动复制：' + address);
            });
        }
    </script>
</body>

</html>